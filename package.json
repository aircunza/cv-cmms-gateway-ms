    "test:e2e:wo:create": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.create.test.ts",
    "test:e2e:wo:find-all": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.find.all.test.ts",
    "test:e2e:wo:find-one": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.find.one.test.ts",
    "test:e2e:wo:update": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.update.test.ts",
    "test:e2e:wo:release": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.release.test.ts",
    "test:e2e:wo:hold": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.hold.test.ts",
    "test:e2e:wo:complete": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.complete.test.ts",
    "test:e2e:wo:close": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.close.test.ts",
    "test:e2e:wo:cancel": "jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/maintenance-execution/work-order.cancel.test.ts",
