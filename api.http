Content-Type: application/json
Authorization: Bearer {{token}}

{
  "workAreaCode": "WA-001",
  "workAreaDescription": "Area principal de mantenimiento",
  "organizationCode": "ORG-BOG-001"
}

### Nota: copia el id devuelto en create y pegalo en @workAreaId

### Get one work area
GET {{baseUrl}}/work-areas/{{workAreaId}}
Authorization: Bearer {{token}}

### Get work areas (all active by default)
GET {{baseUrl}}/work-areas
Authorization: Bearer {{token}}

### Get work areas filtered by code
GET {{baseUrl}}/work-areas?workAreaCode=WA-001
Authorization: Bearer {{token}}

### Get work areas filtered by organizationCode
GET {{baseUrl}}/work-areas?organizationCode=ORG-BOG-001
Authorization: Bearer {{token}}

### Update work area (partial)
PATCH {{baseUrl}}/work-areas/{{workAreaId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "workAreaDescription": "Area principal de mantenimiento - actualizada"
}

### Deactivate work area (soft delete)
PATCH {{baseUrl}}/work-areas/{{workAreaId}}/deactivate
Authorization: Bearer {{token}}




######################## WORK CENTERS ########################
@workCenterId = 7b902e69-a4d2-429f-89af-9be69007618c

