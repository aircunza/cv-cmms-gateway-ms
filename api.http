Content-Type: application/json
Authorization: Bearer {{token}}

{
  "workCenterDescription": "Centro de trabajo principal - actualizado",
  "centerCostDescription": "Costo centro actualizado"
}

### Deactivate work center (soft delete)
PATCH {{baseUrl}}/work-centers/{{workCenterId}}/deactivate
Authorization: Bearer {{token}}




######################## ASSETS ########################
@assetCode = ASSET-001

### Create asset
POST {{baseUrl}}/assets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetCode": "ASSET-001",
  "assetDescription": "Bomba principal de planta",
  "assetShortDescription": "Bomba P1",
  "assetStatus": "OPERATIVE",
  "operationalHoursOrigin": "MANUAL",
  "organizationCode": "ORG-BOG-001",
  "workCenterId": "{{workCenterId}}",
  "accountingAccountCode": "ACC-100",
  "supervisorCode": "12345",
  "assetDependency": "LINEA-1",
  "processTypeCode": "PROC-A",
  "subprocessTypeCode": "SUBPROC-A1",
  "hierarchyCode": "H-001",
  "assetClass": "CRITICAL",
  "enabledMaintenanceProgram": "Y",
  "enabledMaintenanceHoursControl": "Y",
  "enabledFinancialKpi": "N",
  "enabledTechnicalKpi": "Y",
  "woAllowedFlag": "Y",
  "enabledIiot": "N",
  "sector": "Produccion",
  "subsector": "Linea 1"
}

### Get one asset
GET {{baseUrl}}/assets/{{assetCode}}
Authorization: Bearer {{token}}

### Get assets (all active by default)
GET {{baseUrl}}/assets
Authorization: Bearer {{token}}

### Get assets filtered by code
GET {{baseUrl}}/assets?assetCode=ASSET-001
Authorization: Bearer {{token}}

### Get assets filtered by organizationCode
GET {{baseUrl}}/assets?organizationCode=ORG-BOG-001
Authorization: Bearer {{token}}

### Get assets filtered by supervisorCode
GET {{baseUrl}}/assets?supervisorCode=12345
Authorization: Bearer {{token}}

### Update asset (partial)
PATCH {{baseUrl}}/assets/{{assetCode}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "assetDescription": "Bomba principal de planta - actualizada",
  "assetStatus": "STANDBY",
  "enabledTechnicalKpi": "N",
  "subsector": "Linea 2"
}

### Deactivate asset (soft delete)
PATCH {{baseUrl}}/assets/{{assetCode}}/deactivate
Authorization: Bearer {{token}}

