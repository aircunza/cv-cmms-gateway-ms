POST {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "operationCode": {{woOperationCode}},
  "organizationCode": "{{hrOrganizationCode}}",
  "resourceCode": "{{hrResourceCode}}",
  "plannedHours": 4,
  "actualHours": 2.5,
  "hourlyCost": 35.00,
  "principalFlag": "Y",
  "resourceSequenceNumber": 10,
  "plannedStartDate": "2026-08-01T08:00:00Z",
  "plannedCompletionDate": "2026-08-01T12:00:00Z",
  "usageRate": 1.0
}

### Get human resources for an operation
GET {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources
Authorization: Bearer {{token}}

### Update operation human resource
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources/{{opHrUsageId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "actualHours": 3,
  "hourlyCost": 38.00
}
