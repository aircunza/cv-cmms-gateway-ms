@baseUrl = http://localhost:3000/api/v1


### Login (run first to capture the token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "usuario02@empresa1.pe",
  "password": "Password123!"
}

###
@token = {{login.response.body.$.auth_token}}
@orgCode = ORG-LIMA-001
@actorId = 10000000-0000-4000-8000-000000000011

@hrResourceCode = RES-001
@wrRequestId = 900000001

@woWorkOrderCode = 1001
@woOperationCode = 5006
@opInspectionCode = 5007

# NOTE: these ids are mock placeholders. When using the material and human
# resources endpoints, paste here the ids returned in the "Create" responses.
@opMaterialId = 9001
@opHrUsageId = 9101
@opHrUsageId2 = 9102

######################## HUMAN RESOURCES ########################

### Create human resource
POST {{baseUrl}}/human-resources
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "resourceCode": "{{hrResourceCode}}",
  "resourceName": "Tecnico Mecanico 1",
  "resourceType": "MECHANICAL",
  "organizationCode": "{{orgCode}}",
  "organizationName": "Empresa 1",
  "availabilityStatus": "AVAILABLE",
  "supervisorId": "10000000-0000-4000-8000-000000000017",
  "supervisorName": "Usuario 07"
}

### Get human resources (all)
GET {{baseUrl}}/human-resources?organizationCode={{orgCode}}
Cookie: auth_token={{token}}

### Get one human resource
GET {{baseUrl}}/human-resources/{{hrResourceCode}}?organizationCode={{orgCode}}
Cookie: auth_token={{token}}

### Update human resource
PATCH {{baseUrl}}/human-resources/{{hrResourceCode}}?organizationCode={{orgCode}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "resourceName": "Tecnico Mecanico 1 - Actualizado",
  "availabilityStatus": "ON_LEAVE"
}

### Deactivate human resource
PATCH {{baseUrl}}/human-resources/{{hrResourceCode}}/deactivate?organizationCode={{orgCode}}
Cookie: auth_token={{token}}

######################## WORK REQUESTS ########################

### Create work request
POST {{baseUrl}}/work-requests
Content-Type: application/json
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

{
  "assetCode": "AST-001",
  "assetShortDescription": "Chancadora primaria",
  "issueDescription": "Vibracion excesiva en chancadora primaria detectada en operacion",
  "enableOracleWorkOrder": "N"
}

### Note: copy the requestId returned and paste it into @wrRequestId

### Get work requests (filters as JSON string URL-encoded)
GET {{baseUrl}}/work-requests?filters=%5B%7B%22field%22%3A%22organizationCode%22%2C%22operator%22%3A%22eq%22%2C%22value%22%3A%22ORG-LIMA-001%22%7D%5D&limit=10&offset=0
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

### Get one work request
GET {{baseUrl}}/work-requests/{{wrRequestId}}
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

### Update work request description
PATCH {{baseUrl}}/work-requests/{{wrRequestId}}
Content-Type: application/json
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

{
  "issueDescription": "Vibracion excesiva en chancadora primaria - actualizado"
}

### Complete work request
PATCH {{baseUrl}}/work-requests/{{wrRequestId}}/complete
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

### Cancel work request (cancels the associated Work Order too)
PATCH {{baseUrl}}/work-requests/{{wrRequestId}}/cancel
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

######################## WORK ORDERS ########################

### Create work order
POST {{baseUrl}}/work-orders
Content-Type: application/json
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

{
  "workOrderDescription": "Vibracion excesiva en chancadora primaria detectada en operacion",
  "woStatusCode": "UNRELEASED",
  "assetCode": "AST-001",
  "workOrderType": "Not Planned",
  "workOrderSubType": "Emergency",
  "workOrderPriority": "1",
  "enableOracleWorkOrder": "N",
  "operations": [
    {
      "operationName": "DEFAULT_OPERATION",
      "operationDescription": "Auto-generated default operation",
      "operationSeqNumber": 1,
      "createdBy": "{{actorId}}",
      "operationStatus": "UNRELEASED",
      "operationType": "Internal",
      "operationSubType": "Emergency",
      "actualStartDate": "2026-08-01T08:00:00Z",
      "actualCompletionDate": "2026-08-01T10:30:00Z",
      "workOrderOperationResource": [
        {
          "principalFlag": "Y",
          "resourceCode": "{{hrResourceCode}}",
          "resourceSequenceNumber": 1,
          "actualHours": 2.5,
          "actualStartDate": "2026-08-01T08:00:00Z",
          "actualCompletionDate": "2026-08-01T10:30:00Z"
        }
      ],
      "workOrderOperationMaterial": []
    }
  ]
}

### Note: copy the workOrderCode returned and paste it into @woWorkOrderCode

### Get work orders (filters as JSON string URL-encoded)
GET {{baseUrl}}/work-orders?filters=%5B%7B%22field%22%3A%22organizationCode%22%2C%22operator%22%3A%22eq%22%2C%22value%22%3A%22ORG-LIMA-001%22%7D%5D&limit=10&offset=0
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

### Get one work order
GET {{baseUrl}}/work-orders/{{woWorkOrderCode}}
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

### Update work order
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}
Content-Type: application/json
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

{
  "enableOracleWorkOrder": "N",
  "workOrderDescription": "Vibracion excesiva en chancadora primaria - actualizado",
  "workOrderPriority": "2"
}

### Release work order
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/release
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

### Reprogram work order (updates actualStartDate of the WO and shifts all operations/resources by the delta)
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/reprogram
Content-Type: application/json
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

{
  "newActualStartDate": "2026-08-05T08:00:00Z"
}

### NOTE: Other Work Order status endpoints
# There are more WO status change endpoints besides `release`:
#   PATCH /api/v1/work-orders/:workOrderCode/hold
#   PATCH /api/v1/work-orders/:workOrderCode/complete
#   PATCH /api/v1/work-orders/:workOrderCode/close
#   PATCH /api/v1/work-orders/:workOrderCode/cancel
#   PATCH /api/v1/work-orders/:workOrderCode/pending-approval
# Each endpoint only allows specific transitions (e.g. complete requires RELEASED,
# close requires COMPLETED, cancel is terminal). Read the allowed transitions in
# docs/work-order-spec.md -> "Status Transition Reference". Note that PENDING_APPROVAL
# is an initial status set at creation time only (no transition leads to it); the
# pending-approval endpoint takes a WO from PENDING_APPROVAL to UNRELEASED.

######################## WO OPERATIONS ########################

### Create operation
# NOTE: operationStatus=RELEASED requires the WO to be RELEASED. If the WO was
# created fresh with this file, run the "Release work order" endpoint first.
POST {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "operationName": "Inspection",
  "operationDescription": "Visual inspection of components",
  "operationSeqNumber": 10,
  "assetCode": "AST-001",
  "assetShortDescription": "Chancadora primaria",
  "operationStatus": "RELEASED",
  "operationType": "Internal",
  "organizationCode": "{{orgCode}}",
  "actualStartDate": "2026-08-05T08:00:00Z",
  "actualCompletionDate": "2026-08-05T10:30:00Z",
  "resources": [
    {
      "principalFlag": "Y",
      "resourceCode": "{{hrResourceCode}}",
      "resourceSequenceNumber": 1,
      "actualHours": 2.5,
      "actualStartDate": "2026-08-05T08:00:00Z",
      "actualCompletionDate": "2026-08-05T10:30:00Z"
    }
  ]
}

### Note: copy the operationCode returned and paste it into @opInspectionCode

### Get operations for a work order
GET {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations?assetCode=AST-001&operationStatus=RELEASED
Cookie: auth_token={{token}}

### Get one operation
GET {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{opInspectionCode}}
Cookie: auth_token={{token}}

### Update operation
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{opInspectionCode}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "operationName": "Inspection - Actualizado",
  "operationStatus": "IN_PROCESS"
}

### Review operation
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{opInspectionCode}}/review
Cookie: auth_token={{token}}

### Cancel operation
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{opInspectionCode}}/cancel
Content-Type: application/json
Cookie: auth_token={{token}}
X-Organization-Code: {{orgCode}}

{
  "canceledReason": "Operation no longer needed"
}

######################## OPERATION MATERIALS ########################

### Create operation material
POST {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/materials
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "organizationCode": "{{orgCode}}",
  "materialCode": "MAT-001",
  "materialName": "Empalme de faja vulcanizado",
  "quantity": 1,
  "unitCost": 250.00,
  "supplyType": "1",
  "materialSequenceNumber": 10
}

### Note: copy the id returned and paste it into @opMaterialId

### Get materials for an operation
GET {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/materials
Cookie: auth_token={{token}}

### Update operation material
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/materials/{{opMaterialId}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "quantity": 3,
  "unitCost": 42.00
}

######################## OPERATION HUMAN RESOURCES ########################

### Create operation human resource
POST {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "operationCode": "{{woOperationCode}}",
  "organizationCode": "{{orgCode}}",
  "resourceCode": "{{hrResourceCode}}",
  "actualHours": 2.5,
  "hourlyCost": 35.00,
  "principalFlag": "Y",
  "resourceSequenceNumber": 10,
  "actualStartDate": "2026-08-05T08:00:00Z",
  "actualCompletionDate": "2026-08-05T10:30:00Z"
}

### Note: copy the id returned and paste it into @opHrUsageId

### Get human resources for an operation
GET {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources
Cookie: auth_token={{token}}

### Update operation human resource
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources/{{opHrUsageId}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "actualHours": 3,
  "hourlyCost": 38.00
}

### Create a second operation human resource (needed so a cancel of the first leaves at least one ACTIVE resource)
POST {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "organizationCode": "{{orgCode}}",
  "resourceCode": "{{hrResourceCode}}",
  "actualHours": 1.5,
  "hourlyCost": 30.00,
  "principalFlag": "N",
  "resourceSequenceNumber": 20,
  "actualStartDate": "2026-08-05T10:30:00Z",
  "actualCompletionDate": "2026-08-05T12:00:00Z"
}

### Note: copy the id returned and paste it into @opHrUsageId2

### Cancel operation human resource
PATCH {{baseUrl}}/work-orders/{{woWorkOrderCode}}/operations/{{woOperationCode}}/human-resources/{{opHrUsageId}}/cancel
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "canceledReason": "Resource no longer needed"
}