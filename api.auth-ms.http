@baseUrl = http://localhost:3000/api/v1


### Health check
GET {{baseUrl}}/auth/health

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123ghghghgh7+{}",
  "userName": "Test User",
  "userShortName": "TU",
  "code": "12345"
}

### Login (ejecutar primero para capturar el token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "usuario01@empresa1.pe",
  "password": "Password123!"
}

###
@token = {{login.response.body.$.auth_token}}
@userId = 10000000-0000-4000-8000-000000000011
@orgId = 10000000-0000-4000-8000-000000000001

### Verify user
GET {{baseUrl}}/auth/verify
Cookie: auth_token={{token}}

### Logout
POST {{baseUrl}}/auth/logout
Cookie: auth_token={{token}}

######################## ORGANIZATIONS ########################

### Create organization
POST {{baseUrl}}/organizations
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "code": "ORG-LIMA-001",
  "name": "Empresa 1",
  "countryCode": "PE",
  "countryName": "Peru",
  "timezone": "America/Lima",
  "offsetMinutes": -300
}

### Nota: copia el id devuelto y pégalo en @orgId

### Get one organization
GET {{baseUrl}}/organizations/{{orgId}}
Cookie: auth_token={{token}}

### Get organizations (all active by default)
GET {{baseUrl}}/organizations
Cookie: auth_token={{token}}

### Get organizations filtered by code
GET {{baseUrl}}/organizations?code=ORG-LIMA
Cookie: auth_token={{token}}

### Get organizations filtered by name
GET {{baseUrl}}/organizations?name=Empresa
Cookie: auth_token={{token}}

### Get organizations filtered by countryCode
GET {{baseUrl}}/organizations?countryCode=PE
Cookie: auth_token={{token}}

### Update organization (partial)
PATCH {{baseUrl}}/organizations/{{orgId}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "name": "Empresa 1 S.A.C.",
  "timezone": "America/Lima",
  "offsetMinutes": -300
}

### Update organization (cambiar code: rechazado por la MS)
PATCH {{baseUrl}}/organizations/{{orgId}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "code": "ORG-BOG-002"
}

### Deactivate organization (soft delete)
PATCH {{baseUrl}}/organizations/{{orgId}}/deactivate
Cookie: auth_token={{token}}

######################## USER ORG PERMISSIONS ########################

@uopOrgId = 10000000-0000-4000-8000-000000000001
@uopId = 00000000-0000-0000-0000-000000000000

### Create user org permission
POST {{baseUrl}}/user-org-permissions
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "userId": "10000000-0000-4000-8000-000000000013",
  "organizationId": "{{uopOrgId}}",
  "roleCode": "PLANNER_MAINTENANCE_01",
  "roleName": "Planificador de mantenimiento 1",
  "roleDescription": "Planifica ordenes de trabajo; no puede cancelar",
  "permissions": ["mnt.work.orders.view", "mnt.work.orders.create"],
  "deniedPermissions": ["mnt.work.orders.cancel"]
}

### Nota: copia el id devuelto en create y pégalo en @uopId

### Get one user org permission (active only)
GET {{baseUrl}}/user-org-permissions/{{uopId}}
Cookie: auth_token={{token}}

### Get user org permissions (all active by default)
GET {{baseUrl}}/user-org-permissions
Cookie: auth_token={{token}}

### Get user org permissions filtered by userId
GET {{baseUrl}}/user-org-permissions?userId={{userId}}
Cookie: auth_token={{token}}

### Get user org permissions filtered by organizationId
GET {{baseUrl}}/user-org-permissions?organizationId={{uopOrgId}}
Cookie: auth_token={{token}}

### Get user org permissions filtered by roleCode
GET {{baseUrl}}/user-org-permissions?roleCode=PLANNER_MAINTENANCE_01
Cookie: auth_token={{token}}

### Get user org permissions including inactive
GET {{baseUrl}}/user-org-permissions?isActive=N
Cookie: auth_token={{token}}

### Update user org permission (partial)
PATCH {{baseUrl}}/user-org-permissions/{{uopId}}
Content-Type: application/json
Cookie: auth_token={{token}}

{
  "roleName": "Maintenance Planner Senior",
  "permissions": ["mnt.work.orders.view", "mnt.work.orders.create", "mnt.work.orders.update"]
}

### Deactivate user org permission (soft delete)
PATCH {{baseUrl}}/user-org-permissions/{{uopId}}/deactivate
Cookie: auth_token={{token}}

######################## USERS ########################

### Get all users (no filters)
GET {{baseUrl}}/users
Cookie: auth_token={{token}}

### Get users filtered by single field (code - partial match)
GET {{baseUrl}}/users?code=12345
Cookie: auth_token={{token}}

### Get users filtered by email (partial match)
GET {{baseUrl}}/users?email=usuario01
Cookie: auth_token={{token}}

### Get users filtered by multiple fields (isActive + isVerified)
GET {{baseUrl}}/users?isActive=Y&isVerified=Y
Cookie: auth_token={{token}}

### Get users with pagination (first 10 users)
GET {{baseUrl}}/users?limit=10&offset=0
Cookie: auth_token={{token}}

### Get users with pagination (next 10 users)
GET {{baseUrl}}/users?limit=10&offset=10
Cookie: auth_token={{token}}

### Get users with multiple filters and pagination
GET {{baseUrl}}/users?isActive=Y&isVerified=Y&userName=John&limit=20&offset=0
Cookie: auth_token={{token}}

### Get users filtered by addAttribute1 (partial match)
GET {{baseUrl}}/users?addAttribute1=department1
Cookie: auth_token={{token}}

### Get users filtered by addAttribute2 and addAttribute3
GET {{baseUrl}}/users?addAttribute2=location1&addAttribute3=position1
Cookie: auth_token={{token}}

### Get users with ALL filters combined (complex example)
GET {{baseUrl}}/users?code=4428&email=usuario&userName=John&userShortName=JD&isActive=Y&isVerified=Y&addAttribute1=dept&addAttribute2=loc&addAttribute3=pos&addAttribute4=team&addAttribute5=role&limit=50&offset=0
Cookie: auth_token={{token}}

### Get one user by id
GET {{baseUrl}}/users/{{userId}}
Cookie: auth_token={{token}}